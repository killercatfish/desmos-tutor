# Copy to .env (npm run dev does this the first time). .env is gitignored; keep keys there only.

# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=3001
DB_PATH=data/tutor.db

# --- Desmos ---------------------------------------------------------------
# This is the public demo key from the Desmos API docs. It is for local development only.
# Deploying anywhere requires your own key: https://www.desmos.com/my-api
DESMOS_API_KEY=dcb31709b452b1cf9dc26972add0fda6
DESMOS_API_VERSION=v1.11

# --- Model endpoint (any OpenAI-compatible /v1 chat endpoint) -------------
# Pick ONE block. Local is the default: student data stays on this machine.

# Local llama.cpp server (llama-server --jinja -m model.gguf --port 8080)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen27b

# A GPU box on your LAN or tailnet (llama-swap, llama.cpp, Ollama...)
# LLM_BASE_URL=http://192.168.1.50:11434/v1
# LLM_MODEL=qwen27b

# Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:32b

# vLLM (vllm serve <model> --enable-auto-tool-choice --tool-call-parser hermes)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen3-32B

# LM Studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen3-32b

# --- Cloud providers: FAKE STUDENTS ONLY ----------------------------------
# These send everything typed and graphed to a third party, and they may train on it.
# Demo mode switches on automatically (banner + auto-generated nicknames).

# Gemini (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3-32b
# LLM_API_KEY=

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3-32b
# LLM_API_KEY=

# Only set when the endpoint needs a key. Never commit it.
# LLM_API_KEY=

# auto = try native tool calling, fall back to JSON tool blocks if the endpoint refuses.
LLM_TOOL_MODE=auto
# auto = stream replies, and switch to one-shot replies if the endpoint or a proxy in front of it
# can't stream. Set false to skip the failed first try.
LLM_STREAM=auto
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024

# --- Symbolic math (optional) ---------------------------------------------------
# The tutor's `symbolic` tool (solve, factor, derivative, integral, limit) calls a local SymPy
# sidecar. Set it up once with `npm run sympy:setup`; `npm run dev` starts it if it's set up.
# Set SYMPY_URL= (empty) to turn the tool off. Step checking (check_equivalent) needs nothing extra.
SYMPY_URL=http://127.0.0.1:3002

# --- Privacy ---------------------------------------------------------------
# Leave unset to decide from LLM_BASE_URL: false for localhost / private network, true otherwise.
# When true: yellow demo banner, and nicknames are auto-generated (students can't type one).
# PROVIDER_TRAINS_ON_DATA=

# --- Tutor behavior ---------------------------------------------------------
# Idle nudges: the tutor speaks up after IDLE_NUDGE_SECONDS of no activity, or after
# 3+ graph edits with no chat. Off by default.
NUDGES_ENABLED=false
IDLE_NUDGE_SECONDS=90

# --- Feature flags -----------------------------------------------------------
# "Sign in with Google" (identity only). Stub in v0.1; turning it on only shows a disabled button.
FEATURE_GOOGLE_SIGNIN=false
